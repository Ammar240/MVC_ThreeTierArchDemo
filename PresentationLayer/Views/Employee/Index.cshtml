@model IEnumerable<EmployeeViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>All Employees</h1>
<br />
<br />

<a asp-action="Create" asp-controller="Employee" class="btn btn-primary my-3">Create Employee</a>
<br />

<form class="my-3" asp-action="Index">
    <div class="row">
        <div class="col-8">
            <input class="form-control" name="SearchValue" placeholder="Search by name" />
        </div>
        <div class="col-4">
            <input class="btn btn-success btn-block" type="submit" value="Search" />
        </div>
    </div>
</form>


@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>

                <th>@Html.DisplayNameFor(E => E.Name)</th>
                <th>@Html.DisplayNameFor(E => E.Address)</th>
                <th>@Html.DisplayNameFor(E => E.Age)</th>
                <th>@Html.DisplayNameFor(E => E.Salary)</th>
                <th>@Html.DisplayNameFor(E => E.Email)</th>
                <th>@Html.DisplayNameFor(E => E.Phone)</th>
                <th>@Html.DisplayNameFor(E => E.IsActive)</th>

                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>

                    <td>@Html.DisplayFor(M => @employee.Name)</td>
                    <td>@Html.DisplayFor(M => @employee.Address)</td>
                    <td>@Html.DisplayFor(M => @employee.Age)</td>
                    <td>@Html.DisplayFor(M => @employee.Salary)</td>
                    <td>@Html.DisplayFor(M => @employee.Email)</td>
                    <td>@Html.DisplayFor(M => @employee.Phone)</td>
                    <td>@Html.DisplayFor(M => @employee.IsActive)</td>

                    <partial name="_ButtonsPartialView" model="@employee.Id" />
                </tr>
            }

        </tbody>
    </table>
}

else
{
    <div class=" mt-3 alert alert-warning">
        <h4>There Is No Employees</h4>
    </div>
}

