@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Index";
}

<h1>All Employees</h1>
<br />
<br />
<a asp-action="Create" asp-controller="Employee" class="btn btn-primary">Create Employee</a>
<br />
@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>

                <th>@Html.DisplayNameFor(E => E.Name)</th>
                <th>@Html.DisplayNameFor(E => E.Address)</th>
                <th>@Html.DisplayNameFor(E => E.Age)</th>
                <th>@Html.DisplayNameFor(E => E.Salary)</th>
                <th>@Html.DisplayNameFor(E => E.Email)</th>
                <th>@Html.DisplayNameFor(E => E.Phone)</th>
                <th>@Html.DisplayNameFor(E => E.IsActive)</th>

                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>

                    <td>@Html.DisplayFor(M => @employee.Name)</td>
                    <td>@Html.DisplayFor(M => @employee.Address)</td>
                    <td>@Html.DisplayFor(M => @employee.Age)</td>
                    <td>@Html.DisplayFor(M => @employee.Salary)</td>
                    <td>@Html.DisplayFor(M => @employee.Email)</td>
                    <td>@Html.DisplayFor(M => @employee.Phone)</td>
                    <td>@Html.DisplayFor(M => @employee.IsActive)</td>

                    <td>
                        <a asp-action="Details" asp-controller="Employee" asp-route-Id="@employee.Id" class="btn btn-success">
                            <i class="fas fa-eye"></i>  Details
                        </a>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-controller="Employee" asp-route-Id="@employee.Id" class="btn btn-warning">
                            <i class="fas fa-edit"></i>  Update
                        </a>
                    </td>
                    <td>
                        <a asp-action="Delete" asp-controller="Employee" asp-route-Id="@employee.Id" class="btn btn-danger">
                            <i class="fas fa-trash"></i>  Delete
                        </a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
}

else
{
    <div class=" mt-3 alert alert-warning">
        <h4>There Is No Employees</h4>
    </div>
}

