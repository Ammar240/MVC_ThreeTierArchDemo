@model Employee
@{
    ViewData["Title"] = "Delete";
}

<h1>Are you sure you want to Delete this Department ?</h1>
<form asp-action="Delete">
    <input hidden asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name" class="col-form-label"></label>
        <input class="form-control" asp-for="Name" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Address" class="col-form-label"></label>
        <input class="form-control" asp-for="Address" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Age" class="col-form-label"></label>
        <input class="form-control" asp-for="Age" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Salary" class="col-form-label"></label>
        <input class="form-control" asp-for="Salary" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Email" class="col-form-label"></label>
        <input class="form-control" asp-for="Email" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Phone" class="col-form-label"></label>
        <input class="form-control" asp-for="Phone" readonly />
    </div>

    <div class="form-check">
        <input class="form-check-input" asp-for="IsActive" disabled/>
        <label class="form-check-label " asp-for="IsActive"></label>
    </div>

    <div>
        @* <a asp-action="Delete" class="btn btn-danger">Delete</a> | *@
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" asp-route-Id="@Model.Id" class="btn btn-light">Back to list</a>

    </div>
</form>
