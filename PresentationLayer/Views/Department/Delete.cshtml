@model Department
@{
    ViewData["Title"] = "Delete";
}

<h1>Are you sure you want to Delete this Department ?</h1>
<form asp-action="Delete">
    <input hidden asp-for="Id" />
    <div class="form-group">
        <label asp-for="Code" class="col-form-label"></label>
        <input class="form-control" asp-for="Code" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Name" class="col-form-label"></label>
        <input class="form-control" asp-for="Name" readonly />
    </div>
    <div class="form-group">
        <label asp-for="DateOFCreation" class="col-form-label"></label>
        <input class="form-control" asp-for="DateOFCreation" readonly />

    </div>
    <div>
        @* <a asp-action="Delete" class="btn btn-danger">Delete</a> | *@
        <input type="submit" value="Delete" class="btn btn-danger"/> |
        <a asp-action="Index" asp-route-Id="@Model.Id" class="btn btn-light">Back to list</a>

    </div>
</form>
