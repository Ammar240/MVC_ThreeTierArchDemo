@model IEnumerable<DepartmentViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>All Departmets</h1>
<br />
<br />
<a asp-action="Create" asp-controller="Department" class="btn btn-primary">Create Department</a>
<br />

<form class="my-3" asp-action="Index">
    <div class="row">
        <div class="col-8">
            <input class="form-control" name="SearchValue" placeholder="Search by name" />
        </div>
        <div class="col-4">
            <input class="btn btn-success btn-block" type="submit" value="Search" />
        </div>
    </div>
</form>


@* 
<div class="alert alert-warning mt-3">
    @ViewData["Message"]
</div> *@

@if (TempData["Message"] != null)
{
    <div class="alert alert-success mt-4">
        @TempData["Message"]
    </div>
}

@if (TempData["DelMessage"] != null)
{
    <div class="alert alert-danger mt-4">
        @TempData["DelMessage"]
    </div>
}
@* 
<div class="alert alert-warning mt-3">
    @TempData["Message"]
</div> *@

@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(D => D.Code)</th>
                <th>@Html.DisplayNameFor(D => D.Name)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    

                    <partial name="_ButtonsPartialView" model="@department.Id"/>
                </tr>

                
            }

        </tbody>
    </table>
}

else
{
    <div class=" mt-3 alert alert-warning">
        <h4>There Is No Departments</h4>
    </div>
}

